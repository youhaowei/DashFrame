{
  "name": "@dashframe/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build:main": "node scripts/build-main.mjs",
    "build:preload": "esbuild src/preload.ts --bundle --platform=node --external:electron --format=cjs --outfile=dist/preload.cjs",
    "build": "bun run build:main && bun run build:preload",
    "dev": "bun scripts/dev.mjs",
    "test": "vp test run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "vp lint src",
    "check": "bun run typecheck && bun run lint && bun run test",
    "verify:engine": "bun scripts/verify-native-engine.mjs",
    "stage:convex": "bun scripts/stage-convex.ts"
  },
  "dependencies": {
    "@dashframe/desktop-types": "workspace:*",
    "@dashframe/engine-server": "workspace:*",
    "@dashframe/server": "workspace:*",
    "@dashframe/server-core": "workspace:*",
    "@duckdb/node-api": "1.5.3-r.3",
    "@earendil-works/pi-agent-core": "0.79.6",
    "@earendil-works/pi-ai": "0.79.6",
    "@hono/node-server": "^1.19.12",
    "@hono/node-ws": "^1.3.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@notionhq/client": "^2.2.0",
    "@wystack/secret-vault": "workspace:*",
    "apache-arrow": "^21.1.0",
    "electron": "^33.2.1",
    "hono": "^4.12.9",
    "pg": "^8.13.3",
    "postgres": "^3.4.9",
    "typebox": "1.1.38",
    "ws": "^8.18.0",
    "zod": "^4.3.6",
    "convex": "1.37.0",
    "@dashframe/convex-local": "workspace:*",
    "@dashframe/convex-backend": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "esbuild": "^0.28.0",
    "typescript": "5.7.2",
    "vitest": "catalog:",
    "vite-plus": "catalog:"
  }
}
