    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@dashframe/engine": "workspace:*",
    "@dashframe/engine-browser": "workspace:*",
    "apache-arrow": "^21.1.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "catalog:",
    "typescript": "^5.6.0",
    "vitest": "catalog:",
    "vite-plus": "catalog:"
  }
