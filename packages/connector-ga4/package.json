{
  "name": "@dashframe/connector-ga4",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bun": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./catalogue": {
      "types": "./src/catalogue.ts",
      "bun": "./src/catalogue.ts",
