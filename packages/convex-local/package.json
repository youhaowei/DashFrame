  },
  "dependencies": {
    "convex": "1.37.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "typescript": "5.7.2",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  }
}
