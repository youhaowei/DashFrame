{
  "name": "@dashframe/convex-local",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "provision": "bun scripts/provision.ts",
    "typecheck": "tsc --noEmit",
