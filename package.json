{
  "name": "dashframe",
  "version": "0.2.0-alpha.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "packageManager": "bun@1.3.5",
  "workspaces": [
    "apps/*",
    "packages/*",
    "libs/stdui/packages/*",
    "libs/wystack/packages/*",
    "e2e/*"
  ],
  "overrides": {
    "@duckdb/duckdb-wasm": "1.32.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,jsx,ts,tsx,json,css,md,yml,yaml}": "vp fmt"
  },
  "scripts": {
    "setup": "git submodule update --init --recursive && bun install && bun run build:wystack",
    "build:wystack": "bun run --cwd libs/wystack build",
    "dev": "sh -c 'exec node apps/desktop/scripts/dev.mjs'",
    "dev:info": "node scripts/dev-worktree.mjs identity",
    "dev:status": "node scripts/dev-worktree.mjs status-all",
    "dev:desktop:status": "DASHFRAME_DEV_SURFACE=desktop node scripts/dev-worktree.mjs status",
    "dev:web": "turbo dev --filter=@dashframe/web",
    "dev:web:agent": "turbo build --filter=@dashframe/web^... && sh -c 'exec scripts/dev-web.sh vp dev'",
    "dev:web:status": "DASHFRAME_DEV_SURFACE=web node scripts/dev-worktree.mjs status",
    "dev:web:fresh": "DASHFRAME_PROJECT_DIR=\"$(mktemp -d)\" sh -c 'echo \"[dev] fresh project dir: $DASHFRAME_PROJECT_DIR\"; exec bun run dev:web'",
    "build": "turbo build",
    "lint": "turbo lint",
    "format": "vp fmt .",
    "format:check": "vp fmt --check .",
    "test": "turbo test",
    "test:coverage": "turbo test:coverage",
    "test:e2e": "turbo test:e2e",
    "test:e2e:ci": "turbo test:e2e:ci",
    "test:e2e:ui": "bun run --filter @dashframe/web-e2e test:ui",
    "typecheck": "turbo typecheck",
    "check:ticket-refs": "node scripts/check-no-ticket-refs.mjs",
    "check:wystack-domain-nouns": "node scripts/check-wystack-domain-nouns.mjs",
    "check:apply-commands-boundary": "node scripts/check-apply-commands-boundary.mjs",
    "check:packages": "turbo check --filter=!@wystack/* --continue=dependencies-successful",
    "check": "node scripts/run-checks.mjs",
    "clean": "turbo clean",
    "storybook": "turbo storybook",
    "build-storybook": "turbo build-storybook",
    "prepare": "husky",
    "changeset": "changeset",
    "changeset:ai": "node scripts/ai-changeset.mjs",
    "changeset:status": "changeset status",
    "version": "changeset version && node scripts/annotate-web-changelog.mjs",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.71.2",
    "@changesets/changelog-github": "^0.5.2",
    "@changesets/cli": "^2.29.8",
    "@next/eslint-plugin-next": "16.0.10",
    "@types/bun": "^1.3.10",
    "@types/node": "^22.10.1",
    "commander": "^14.0.3",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-sonarjs": "^3.0.5",
    "eslint-plugin-storybook": "10.1.11",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "shadcn": "^3.6.1",
    "tailwindcss": "4.1.16",
    "turbo": "^2.7.3",
    "typescript": "5.7.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "dependencies": {
    "convex": "^1.29.3"
  },
  "catalog": {
    "@vitest/browser-playwright": "4.1.10",
    "@vitest/coverage-v8": "4.1.10",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.9",
    "vitest": "4.1.10",
    "vite-plus": "0.2.9"
  }
}
